# Copia este fichero a .env en tu proyecto y rellena los valores.
# El .env NO debe versionarse.

# --- Proyecto ---
# PROJECT=myproject
# Versión del proyecto (también se gestiona con `make version` / `make version-bump`)
# VERSION=1.0.0

# --- Git ---
GIT_REMOTE=origin
GIT_BRANCH=main
COMMIT_MSG="Automated commit by makeit"

# --- FTP ---
FTP_SERVER=ftp://ftp.example.org
FTP_USERNAME=
FTP_PASSWORD=
FTP_REMOTE_PATH=/
FTP_LOCAL_DIR=public
FTP_DELETE=0

# --- Hugo ---
HUGO_VERSION=0.152.2
HUGO_PORT=1313

# --- Test / Lint ---
# TEST_CMD=python -m pytest
# LINT_CMD=ruff check .

# --- Docker ---
# DOCKER_IMAGE=myapp
# DOCKER_TAG=latest
# DOCKER_REGISTRY=ghcr.io/user
